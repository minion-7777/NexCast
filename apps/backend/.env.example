# Server
PORT=3001
NODE_ENV=development

# Comma-separated origins (frontend URL on Windows host)
CORS_ORIGIN=http://localhost:5173

# LiveKit (must match media-server keys)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production
# HTTP API URL of LiveKit on Ubuntu VM (no trailing slash)
LIVEKIT_HTTP_URL=http://192.168.1.100:7880
# WebSocket URL returned to browsers
LIVEKIT_WS_URL=ws://192.168.1.100:7880

# Optional: require this header on API calls (leave empty to disable)
# INTERNAL_API_KEY=your-shared-secret
